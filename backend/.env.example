# Локальный .env для запуска backend вне docker-compose (например, `npm run start:dev`
# напрямую на хосте против postgres, поднятого `docker compose up postgres`).
# Внутри docker-compose эти переменные приходят из окружения контейнера
# (см. корневой docker-compose.yml, сервис backend) — этот файл не требуется.

PORT=8080
NODE_ENV=development
DATABASE_URL=postgres://linkboard:linkboard@localhost:5432/linkboard
BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000
