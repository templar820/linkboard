{
  "name": "linkboard-e2e-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сквозные Playwright-сценарии против admin-panel. Отдельный проект: не импортирует исходники backend/frontend, только браузер и HTTP.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
