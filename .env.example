# Скопируйте этот файл в .env и при необходимости отредактируйте значения.
# docker-compose.yml читает .env автоматически.

# --- PostgreSQL ---
POSTGRES_USER=linkboard
POSTGRES_PASSWORD=linkboard
POSTGRES_DB=linkboard
POSTGRES_PORT=5432

# --- Backend (Nest.js) ---
BACKEND_PORT=8080
PORT=8080
NODE_ENV=development

# Dev-база приложения (контейнер backend обращается к postgres по имени сервиса в сети compose)
DATABASE_URL=postgres://linkboard:linkboard@postgres:5432/linkboard

# Изолированная база для api-tests / e2e-tests
TEST_DATABASE_URL=postgres://linkboard:linkboard@postgres:5432/linkboard_test

# Базовый URL, используемый для построения shortUrl в ответах API
BASE_URL=http://localhost:8080

# Origin admin-panel, разрешённый в CORS
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Vite + React) ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
